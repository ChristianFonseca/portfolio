# Variables que necesita la app. Referencia + uso en desarrollo local (copiar a .env).
#
# EN PRODUCCIÓN NO HAY .env: los secretos viven en Bitwarden Secrets Manager y `bws run`
# los inyecta solo en el proceso node al arrancar el contenedor. Lo único que existe en
# el VPS es /root/portfolio-bws.env (chmod 600) con BWS_ACCESS_TOKEN y BWS_PROJECT_ID.
# Para cambiar un secreto en producción: editarlo en Bitwarden y reiniciar el contenedor.
# NUNCA commitear .env.

# Postgres del contenido y usuarios del admin.
# En el VPS (red docker pg-shared): postgres://portfolio:<pass>@pg-dev:5432/portfolio
# En local vía túnel SSH:           postgres://portfolio:<pass>@127.0.0.1:15432/portfolio
DATABASE_URL=

# Secreto para firmar la cookie de sesión del admin y seudonimizar IPs (64+ chars aleatorios)
SESSION_SECRET=

# API key de Gemini (https://aistudio.google.com/apikey): traducción EN<->ES, chat y
# catálogo de modelos. El modelo, el de respaldo y la base de conocimiento se gestionan
# en el admin (Configuración).
GEMINI_API_KEY=

# Resend (formulario de contacto): https://resend.com/api-keys
RESEND_API_KEY=

# Remitente del email de contacto: dirección del dominio verificado en Resend
# (default: no-reply@christianfonseca.dev)
CONTACT_FROM_EMAIL=

# Destinatario de los mensajes del formulario (default: christian.fonseca.r@gmail.com)
CONTACT_TO_EMAIL=

# Carpeta de imágenes subidas desde el admin. En el VPS es el volumen /data/uploads;
# en local puede omitirse (cae en public/uploads).
UPLOADS_DIR=
